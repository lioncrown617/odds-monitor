<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏇 HKJC 賠率監察</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0d1117; color: #e6edf3; font-family: 'Segoe UI', Arial, sans-serif; font-size: 14px; }

  header { background: #161b22; border-bottom: 2px solid #238636; padding: 16px 24px;
           display: flex; align-items: center; justify-content: space-between; }
  header h1 { font-size: 20px; color: #58a6ff; }
  #status-badge { padding: 4px 12px; border-radius: 12px; font-size: 12px;
                  background: #21262d; border: 1px solid #30363d; }
  #status-badge.running { border-color: #238636; color: #3fb950; }
  #status-badge.stopped { border-color: #da3633; color: #f85149; }

  .container { max-width: 1400px; margin: 0 auto; padding: 16px; }

  /* 設定表單 */
  .config-panel { background: #161b22; border: 1px solid #30363d; border-radius: 8px;
                  padding: 20px; margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; }
  .config-panel label { display: block; color: #8b949e; font-size: 12px; margin-bottom: 4px; }
  .config-panel input, .config-panel select {
    background: #0d1117; border: 1px solid #30363d; color: #e6edf3;
    padding: 8px 12px; border-radius: 6px; font-size: 14px; width: 100%; }
  .config-panel .field { min-width: 140px; }
  .btn { padding: 9px 20px; border-radius: 6px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; }
  .btn-start { background: #238636; color: #fff; }
  .btn-start:hover { background: #2ea043; }
  .btn-stop  { background: #da3633; color: #fff; }
  .btn-stop:hover  { background: #f85149; }

  /* 資訊列 */
  .info-bar { display: flex; gap: 16px; margin-bottom: 12px; flex-wrap: wrap; }
  .info-card { background: #161b22; border: 1px solid #30363d; border-radius: 6px;
               padding: 10px 16px; flex: 1; min-width: 160px; }
  .info-card .label { color: #8b949e; font-size: 11px; }
  .info-card .value { font-size: 16px; font-weight: 600; color: #58a6ff; margin-top: 2px; }

  /* 主表格 */
  .table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #30363d; margin-bottom: 16px; }
  table { width: 100%; border-collapse: collapse; }
  thead th { background: #161b22; padding: 10px 12px; text-align: left;
             border-bottom: 2px solid #30363d; color: #8b949e; font-size: 12px; white-space: nowrap; }
  tbody tr { border-bottom: 1px solid #21262d; transition: background 0.2s; }
  tbody tr:hover { background: #1c2128; }
  tbody td { padding: 9px 12px; white-space: nowrap; }

  /* 走勢顏色 */
  tr.hot   { background: rgba(248, 81, 73, 0.08); }
  tr.warm  { background: rgba(210, 153, 34, 0.08); }
  tr.rise  { background: rgba(63, 185, 80, 0.08); }
  .badge { padding: 2px 8px; border-radius: 10px; font-size: 12px; font-weight: 600; }
  .badge.hot   { background: rgba(248,81,73,0.2);  color: #f85149; }
  .badge.warm  { background: rgba(210,153,34,0.2); color: #d29922; }
  .badge.rise  { background: rgba(63,185,80,0.2);  color: #3fb950; }
  .badge.neutral { color: #484f58; }

  .chg-down { color: #f85149; }
  .chg-up   { color: #3fb950; }
  .base-win { color: #8b949e; }
  .prev-win { color: #58a6ff; }
  .curr-win { font-weight: 700; color: #e6edf3; font-size: 15px; }

  /* 推薦區 */
  .picks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  @media (max-width: 768px) { .picks-grid { grid-template-columns: 1fr; } }
  .picks-panel { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px; }
  .picks-panel h3 { font-size: 14px; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #30363d; }
  .picks-panel.down h3 { color: #f85149; }
  .picks-panel.up   h3 { color: #3fb950; }
  .pick-item { display: flex; align-items: center; gap: 12px; padding: 8px 0;
               border-bottom: 1px solid #21262d; }
  .pick-item:last-child { border-bottom: none; }
  .medal { font-size: 20px; }
  .pick-name { font-weight: 600; color: #e6edf3; }
  .pick-no   { font-size: 11px; color: #8b949e; }
  .pick-stats { margin-left: auto; text-align: right; font-size: 12px; color: #8b949e; }
  .pick-win  { font-size: 18px; font-weight: 700; }
  .pick-win.down { color: #f85149; }
  .pick-win.up   { color: #3fb950; }

  /* 基準賠率固定提示 */
  .base-note { font-size: 11px; color: #484f58; margin-bottom: 8px; }

  #loading { text-align: center; padding: 40px; color: #484f58; }
</style>
</head>
<body>

<header>
  <h1>🏇 HKJC 即時賠率監察</h1>
  <span id="status-badge" class="stopped">● 未啟動</span>
</header>

<div class="container">

  <!-- 設定面板 -->
  <div class="config-panel">
    <div class="field">
      <label>📅 賽馬日期</label>
      <input type="date" id="inp-date">
    </div>
    <div class="field">
      <label>🏟 場地</label>
      <select id="inp-venue">
        <option value="ST">ST - 沙田</option>
        <option value="HV">HV - 跑馬地</option>
      </select>
    </div>
    <div class="field" style="min-width:100px">
      <label>🔢 場次</label>
      <input type="number" id="inp-race" min="1" max="12" value="1">
    </div>
    <div class="field" style="min-width:120px">
      <label>⏱ 更新間隔(秒)</label>
      <input type="number" id="inp-interval" min="15" max="300" value="30">
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-start" onclick="startMonitor()">▶ 開始監察</button>
      <button class="btn btn-stop"  onclick="stopMonitor()">■ 停止</button>
    </div>
  </div>

  <!-- 資訊列 -->
  <div class="info-bar">
    <div class="info-card"><div class="label">場次</div><div class="value" id="info-race">—</div></div>
    <div class="info-card"><div class="label">更新次數</div><div class="value" id="info-count">—</div></div>
    <div class="info-card"><div class="label">最後更新</div><div class="value" id="info-time">—</div></div>
    <div class="info-card"><div class="label">基準時間</div><div class="value" id="info-base">—</div></div>
    <div class="info-card"><div class="label">狀態</div><div class="value" id="info-status" style="font-size:13px">等待中</div></div>
  </div>

  <!-- 主表格 -->
  <p class="base-note">💡 「基準賠率」= 首次抓取時記錄，全程固定不變作參照；「上次賠率」= 上一次更新的數值</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>馬號</th>
          <th>馬名</th>
          <th>檔位</th>
          <th>騎師</th>
          <th>練馬師</th>
          <th>基準賠率</th>
          <th>上次賠率</th>
          <th>獨贏 WIN</th>
          <th>位置 PLACE</th>
          <th>變動</th>
          <th>走勢</th>
        </tr>
      </thead>
      <tbody id="odds-tbody">
        <tr><td colspan="11" id="loading">請設定場次後按「開始監察」</td></tr>
      </tbody>
    </table>
  </div>

  <!-- 推薦區 -->
  <div class="picks-grid">
    <div class="picks-panel down">
      <h3>📉 資金持續流入（落飛）頭三位</h3>
      <div id="picks-down"><p style="color:#484f58;font-size:12px">等待數據...</p></div>
    </div>
    <div class="picks-panel up">
      <h3>📈 賠率持續回升（冷門）頭三位</h3>
      <div id="picks-up"><p style="color:#484f58;font-size:12px">等待數據...</p></div>
    </div>
  </div>

</div>

<script>
  // 預設今日日期
  const today = new Date().toISOString().slice(0,10);
  document.getElementById("inp-date").value = today;

  let pollTimer = null;
  const medals = ["🥇","🥈","🥉"];

  function startMonitor() {
    const payload = {
      date:     document.getElementById("inp-date").value,
      venue:    document.getElementById("inp-venue").value,
      race_no:  document.getElementById("inp-race").value,
      interval: document.getElementById("inp-interval").value,
    };
    fetch("/start", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(payload)
    }).then(r => r.json()).then(d => {
      if (d.ok) {
        setStatus(true);
        startPolling(parseInt(payload.interval) * 1000);
      } else {
        alert(d.msg);
      }
    });
  }

  function stopMonitor() {
    fetch("/stop", {method:"POST"}).then(() => {
      setStatus(false);
      if (pollTimer) clearInterval(pollTimer);
    });
  }

  function setStatus(running) {
    const badge = document.getElementById("status-badge");
    badge.textContent = running ? "● 監察中" : "● 已停止";
    badge.className = running ? "running" : "stopped";
  }

  function startPolling(ms) {
    if (pollTimer) clearInterval(pollTimer);
    fetchData();
    pollTimer = setInterval(fetchData, ms);
  }

  function fetchData() {
    fetch("/data").then(r => r.json()).then(renderAll);
  }

  function renderAll(d) {
    // 資訊列
    document.getElementById("info-race").textContent =
      d.race_date ? `${d.race_date} ${d.venue_name} 第${d.race_no}場` : "—";
    document.getElementById("info-count").textContent = d.update_count || "—";
    document.getElementById("info-time").textContent  = d.last_update  || "—";
    document.getElementById("info-base").textContent  = d.base_time    || "—";
    document.getElementById("info-status").textContent = d.status      || "—";
    setStatus(d.running);

    // 主表格
    const tbody = document.getElementById("odds-tbody");
    if (!d.rows || d.rows.length === 0) {
      tbody.innerHTML = `<tr><td colspan="11" style="text-align:center;padding:30px;color:#484f58">${d.status}</td></tr>`;
      return;
    }
    tbody.innerHTML = d.rows.map(r => {
      const chgClass = r.chg.startsWith("+") ? "chg-up" : r.chg.startsWith("-") ? "chg-down" : "";
      const badgeHtml = r.trend === "—"
        ? `<span class="badge neutral">—</span>`
        : `<span class="badge ${r.trend_css}">${
            r.trend==="急跌"?"🔴 急跌":
            r.trend==="持跌"?"🟡 持跌":
            r.trend==="持升"?"🟢 持升":
            r.trend==="回升"?"🟢 回升":"—"
          }</span>`;
      return `<tr class="${r.trend_css}">
        <td><b>${r.no}</b></td>
        <td>${r.name}</td>
        <td>${r.draw}</td>
        <td>${r.jockey}</td>
        <td>${r.trainer}</td>
        <td class="base-win">${r.base_win}</td>
        <td class="prev-win">${r.prev_win}</td>
        <td class="curr-win">${r.win}</td>
        <td>${r.place}</td>
        <td class="${chgClass}">${r.chg}</td>
        <td>${badgeHtml}</td>
      </tr>`;
    }).join("");

    // 落飛頭三
    const downEl = document.getElementById("picks-down");
    if (d.top_down && d.top_down.length > 0) {
      downEl.innerHTML = d.top_down.map((h,i) => `
        <div class="pick-item">
          <span class="medal">${medals[i]}</span>
          <div>
            <div class="pick-name">${h.name}</div>
            <div class="pick-no">馬號 ${h.no} │ 基準: ${h.base} │ 連跌: ${h.streak}次 │ 累積跌: ${h.drop}%</div>
          </div>
          <div class="pick-stats">
            <div class="pick-win down">${h.win}</div>
            <div>現賠率</div>
          </div>
        </div>`).join("");
    } else {
      downEl.innerHTML = `<p style="color:#484f58;font-size:12px">暫無數據，請等待更多更新...</p>`;
    }

    // 回升頭三
    const upEl = document.getElementById("picks-up");
    if (d.top_up && d.top_up.length > 0) {
      upEl.innerHTML = d.top_up.map((h,i) => `
        <div class="pick-item">
          <span class="medal">${medals[i]}</span>
          <div>
            <div class="pick-name">${h.name}</div>
            <div class="pick-no">馬號 ${h.no} │ 基準: ${h.base} │ 連升: ${h.streak}次 │ 累積升: ${h.rise}%</div>
          </div>
          <div class="pick-stats">
            <div class="pick-win up">${h.win}</div>
            <div>現賠率</div>
          </div>
        </div>`).join("");
    } else {
      upEl.innerHTML = `<p style="color:#484f58;font-size:12px">暫無數據，請等待更多更新...</p>`;
    }
  }
</script>
</body>
</html>
