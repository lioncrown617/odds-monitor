<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏇 HKJC 賠率監察</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0d1117; color: #e6edf3; font-family: 'Segoe UI', Arial, sans-serif; font-size: 14px; }

  header { background: #161b22; border-bottom: 2px solid #f0c040; padding: 14px 24px;
           display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  header h1 { font-size: 18px; color: #f0c040; }
  #status-badge { padding: 4px 12px; border-radius: 12px; font-size: 12px;
                  background: #21262d; border: 1px solid #30363d; }
  #status-badge.running { border-color: #238636; color: #3fb950; }
  #status-badge.stopped { border-color: #da3633; color: #f85149; }

  .container { max-width: 1500px; margin: 0 auto; padding: 16px; }

  .config-panel { background: #161b22; border: 1px solid #30363d; border-radius: 8px;
                  padding: 16px 20px; margin-bottom: 14px;
                  display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; }
  .config-panel label { display: block; color: #8b949e; font-size: 11px; margin-bottom: 4px; }
  .config-panel input, .config-panel select {
    background: #0d1117; border: 1px solid #30363d; color: #e6edf3;
    padding: 7px 10px; border-radius: 6px; font-size: 13px; width: 100%; }
  .field { min-width: 130px; }
  .btn { padding: 8px 18px; border-radius: 6px; border: none; cursor: pointer; font-size: 13px; font-weight: 600; }
  .btn-start { background: #238636; color: #fff; }
  .btn-start:hover { background: #2ea043; }
  .btn-stop  { background: #da3633; color: #fff; }
  .btn-stop:hover { background: #f85149; }

  .info-bar { display: flex; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .info-card { background: #161b22; border: 1px solid #30363d; border-radius: 6px;
               padding: 8px 14px; flex: 1; min-width: 140px; }
  .info-card .label { color: #8b949e; font-size: 11px; }
  .info-card .value { font-size: 15px; font-weight: 600; color: #f0c040; margin-top: 2px; }

  /* 主表格 */
  .table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #30363d; margin-bottom: 14px; }
  table { width: 100%; border-collapse: collapse; }
  thead th { background: #161b22; padding: 9px 10px; text-align: left;
             border-bottom: 2px solid #30363d; color: #8b949e; font-size: 11px; white-space: nowrap; }
  thead th.win-col { color: #f0c040; }
  tbody tr { border-bottom: 1px solid #21262d; transition: background 0.2s; cursor: pointer; }
  tbody tr:hover { background: #1c2128; }
  tbody td { padding: 8px 10px; white-space: nowrap; }
  tr.hot   { background: rgba(248,81,73,0.08); }
  tr.warm  { background: rgba(210,153,34,0.08); }
  tr.rise  { background: rgba(63,185,80,0.08); }
  .badge { padding: 2px 7px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .badge.hot    { background: rgba(248,81,73,0.2);  color: #f85149; }
  .badge.warm   { background: rgba(210,153,34,0.2); color: #d29922; }
  .badge.rise   { background: rgba(63,185,80,0.2);  color: #3fb950; }
  .badge.neutral{ color: #484f58; }
  .chg-down { color: #f85149; }
  .chg-up   { color: #3fb950; }
  .base-win { color: #8b949e; }
  .prev-win { color: #8b949e; }
  .curr-win { font-weight: 700; font-size: 16px; color: #f0c040; }  /* ★ 黃色 */

  /* 走勢圖 */
  .chart-section { background: #161b22; border: 1px solid #f0c04044; border-radius: 8px;
                   padding: 16px; margin-bottom: 14px; }
  .chart-section h3 { color: #f0c040; font-size: 14px; margin-bottom: 12px; }
  .chart-controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .horse-btn { padding: 4px 10px; border-radius: 12px; border: 1px solid #f0c04066;
               background: #21262d; color: #f0c040; cursor: pointer; font-size: 12px; transition: all 0.2s; }
  .horse-btn:hover  { border-color: #f0c040; background: #f0c04022; }
  .horse-btn.active { background: #f0c04033; border-color: #f0c040; color: #ffe066; font-weight: 600; }
  .chart-wrap { position: relative; height: 340px; }
  .chart-hint { font-size: 11px; color: #484f58; margin-top: 8px; }

  /* 推薦 */
  .picks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  @media (max-width: 700px) { .picks-grid { grid-template-columns: 1fr; } }
  .picks-panel { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px; }
  .picks-panel h3 { font-size: 13px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid #30363d; }
  .picks-panel.down h3 { color: #f85149; }
  .picks-panel.up   h3 { color: #3fb950; }
  .pick-item { display: flex; align-items: center; gap: 10px; padding: 7px 0; border-bottom: 1px solid #21262d; }
  .pick-item:last-child { border-bottom: none; }
  .medal { font-size: 18px; }
  .pick-name { font-weight: 600; font-size: 13px; }
  .pick-no   { font-size: 11px; color: #8b949e; }
  .pick-stats { margin-left: auto; text-align: right; font-size: 11px; color: #8b949e; }
  .pick-win  { font-size: 17px; font-weight: 700; }
  .pick-win.down { color: #f85149; }
  .pick-win.up   { color: #3fb950; }
  .base-note { font-size: 11px; color: #484f58; margin-bottom: 6px; }
</style>
</head>
<body>

<header>
  <h1>🏇 HKJC 即時賠率監察</h1>
  <span id="status-badge" class="stopped">● 未啟動</span>
</header>

<div class="container">

  <!-- 設定 -->
  <div class="config-panel">
    <div class="field">
      <label>📅 賽馬日期</label>
      <input type="date" id="inp-date">
    </div>
    <div class="field">
      <label>🏟 場地</label>
      <select id="inp-venue">
        <option value="ST">ST - 沙田</option>
        <option value="HV">HV - 跑馬地</option>
      </select>
    </div>
    <div class="field" style="min-width:90px">
      <label>🔢 場次</label>
      <input type="number" id="inp-race" min="1" max="12" value="1">
    </div>
    <div class="field" style="min-width:110px">
      <label>⏱ 間隔(秒)</label>
      <input type="number" id="inp-interval" min="15" max="300" value="30">
    </div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-start" onclick="startMonitor()">▶ 開始監察</button>
      <button class="btn btn-stop"  onclick="stopMonitor()">■ 停止</button>
    </div>
  </div>

  <!-- 資訊列 -->
  <div class="info-bar">
    <div class="info-card"><div class="label">場次</div><div class="value" id="info-race">—</div></div>
    <div class="info-card"><div class="label">更新次數</div><div class="value" id="info-count">—</div></div>
    <div class="info-card"><div class="label">最後更新</div><div class="value" id="info-time">—</div></div>
    <div class="info-card"><div class="label">基準時間</div><div class="value" id="info-base">—</div></div>
    <div class="info-card"><div class="label">狀態</div><div class="value" id="info-status" style="font-size:12px">等待中</div></div>
  </div>

  <!-- 主表格 -->
  <p class="base-note">💡 點擊任意一行可在走勢圖中高亮顯示該馬匹｜「基準賠率」= 首次抓取，全程固定不變</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>馬號</th><th>馬名</th><th>檔</th><th>騎師</th><th>練馬師</th>
          <th>基準賠率</th><th>上次賠率</th>
          <th class="win-col">⭐ 獨贏 WIN</th>
          <th>位置</th><th>變動</th><th>走勢</th>
        </tr>
      </thead>
      <tbody id="odds-tbody">
        <tr><td colspan="11" style="text-align:center;padding:30px;color:#484f58">請設定場次後按「開始監察」</td></tr>
      </tbody>
    </table>
  </div>

  <!-- 走勢圖 -->
  <div class="chart-section">
    <h3>📈 獨贏賠率走勢圖（黃色折線）</h3>
    <div class="chart-controls" id="horse-btns"></div>
    <div class="chart-wrap">
      <canvas id="oddsChart"></canvas>
    </div>
    <p class="chart-hint">💡 點擊馬號按鈕或表格行可高亮單匹馬走勢｜Y軸反轉：賠率愈低＝愈熱門（在上方）</p>
  </div>

  <!-- 推薦 -->
  <div class="picks-grid">
    <div class="picks-panel down">
      <h3>📉 資金持續流入（落飛）頭三位</h3>
      <div id="picks-down"><p style="color:#484f58;font-size:12px">等待數據...</p></div>
    </div>
    <div class="picks-panel up">
      <h3>📈 賠率持續回升（冷門）頭三位</h3>
      <div id="picks-up"><p style="color:#484f58;font-size:12px">等待數據...</p></div>
    </div>
  </div>

</div>

<script>
const today = new Date().toISOString().slice(0,10);
document.getElementById("inp-date").value = today;

let pollTimer     = null;
let oddsChart     = null;
let allHistory    = {};
let allNames      = {};
let allTimestamps = [];
let activeHorses  = new Set();
const medals = ["🥇","🥈","🥉"];

// ★ 獨贏統一黃色
const WIN_COLOR       = "#f0c040";
const WIN_COLOR_BRIGHT= "#ffe066";
const WIN_COLOR_FILL  = "#f0c04018";
const WIN_COLOR_HIGHLIGHT = "#f0c04044";

// ── Chart 初始化 ─────────────────────────────────────
function initChart() {
  const ctx = document.getElementById("oddsChart").getContext("2d");
  oddsChart = new Chart(ctx, {
    type: "line",
    data: { labels: [], datasets: [] },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 400 },
      interaction: { mode: "index", intersect: false },
      plugins: {
        legend: {
          labels: {
            color: "#f0c040",   // ★ 圖例文字黃色
            font: { size: 11 },
            boxWidth: 14,
            usePointStyle: true,
            pointStyle: "circle"
          }
        },
        tooltip: {
          backgroundColor: "#161b22",
          borderColor: "#f0c04066",
          borderWidth: 1,
          titleColor: "#f0c040",
          bodyColor: "#e6edf3",
          callbacks: {
            title: items => `🕐 ${items[0].label}`,
            label: ctx => ` 馬號${ctx.dataset.label}  獨贏：${ctx.parsed.y ?? "—"}`
          }
        }
      },
      scales: {
        x: {
          ticks: { color: "#8b949e", font: { size: 10 }, maxRotation: 45 },
          grid:  { color: "#21262d" }
        },
        y: {
          reverse: true,
          ticks: { color: "#f0c040", font: { size: 11 } },  // ★ 黃色刻度
          grid:  { color: "#21262d" },
          title: {
            display: true,
            text: "獨贏賠率（低＝熱門）",
            color: "#f0c040",   // ★ 黃色標題
            font: { size: 11 }
          }
        }
      }
    }
  });
}

// ── 更新圖表（全黃色系）───────────────────────────────
function updateChart() {
  if (!oddsChart) return;
  const horses = Object.keys(allHistory);
  if (horses.length === 0) return;

  oddsChart.data.labels = allTimestamps;
  const hasActive = activeHorses.size > 0;

  const datasets = horses.map((no) => {
    const isHighlight = activeHorses.has(no);
    const isActive    = !hasActive || isHighlight;

    // 高亮：亮黃粗線；其他：淡黃細線
    const lineColor = isHighlight ? WIN_COLOR_BRIGHT : WIN_COLOR;
    const fillColor = isHighlight ? WIN_COLOR_HIGHLIGHT : WIN_COLOR_FILL;
    const lineWidth = isHighlight ? 3 : 1.2;
    const ptRadius  = isHighlight ? 5 : 2;
    const alpha     = hasActive && !isHighlight ? 0.2 : 1;

    return {
      label:                no + " " + (allNames[no] || ""),
      data:                 allHistory[no],
      borderColor:          lineColor,
      backgroundColor:      fillColor,
      borderWidth:          lineWidth,
      pointRadius:          ptRadius,
      pointBackgroundColor: lineColor,
      pointBorderColor:     isHighlight ? "#fff" : lineColor,
      pointBorderWidth:     isHighlight ? 1.5 : 0,
      tension:              0.35,
      hidden:               !isActive,
      spanGaps:             true,
      borderDash:           [],
      // 透明度靠 borderColor alpha 模擬
      borderColor: hexAlpha(lineColor, alpha),
      pointBackgroundColor: hexAlpha(lineColor, alpha),
    };
  });

  oddsChart.data.datasets = datasets;
  oddsChart.update("active");
}

// hex + alpha 工具
function hexAlpha(hex, alpha) {
  if (alpha >= 1) return hex;
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${alpha})`;
}

// ── 馬號按鈕 ─────────────────────────────────────────
function buildHorseBtns(horses) {
  const wrap = document.getElementById("horse-btns");
  if (wrap.children.length === Object.keys(horses).length + 1) return;
  wrap.innerHTML = "";

  const allBtn = document.createElement("button");
  allBtn.className   = "horse-btn active";
  allBtn.textContent = "全部";
  allBtn.onclick     = () => toggleAll(allBtn);
  wrap.appendChild(allBtn);

  Object.entries(horses).forEach(([no, name]) => {
    const btn = document.createElement("button");
    btn.className   = "horse-btn";
    btn.dataset.no  = no;
    btn.textContent = `${no} ${name}`;
    btn.onclick = () => toggleHorse(no, btn);
    wrap.appendChild(btn);
  });
}

function toggleAll(btn) {
  activeHorses.clear();
  document.querySelectorAll(".horse-btn").forEach(b => b.classList.remove("active"));
  btn.classList.add("active");
  updateChart();
}

function toggleHorse(no, btn) {
  document.querySelector(".horse-btn:first-child").classList.remove("active");
  if (activeHorses.has(no)) {
    activeHorses.delete(no);
    btn.classList.remove("active");
  } else {
    activeHorses.add(no);
    btn.classList.add("active");
  }
  if (activeHorses.size === 0) {
    document.querySelector(".horse-btn:first-child").classList.add("active");
  }
  updateChart();
}

// ── Flask 通訊 ────────────────────────────────────────
function startMonitor() {
  const payload = {
    date:     document.getElementById("inp-date").value,
    venue:    document.getElementById("inp-venue").value,
    race_no:  document.getElementById("inp-race").value,
    interval: document.getElementById("inp-interval").value,
  };
  fetch("/start", {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify(payload)
  }).then(r => r.json()).then(d => {
    if (d.ok) {
      setStatus(true);
      activeHorses.clear();
      if (!oddsChart) initChart();
      else { oddsChart.data.labels = []; oddsChart.data.datasets = []; oddsChart.update(); }
      startPolling(parseInt(payload.interval) * 1000);
    } else { alert(d.msg); }
  });
}

function stopMonitor() {
  fetch("/stop", {method:"POST"}).then(() => {
    setStatus(false);
    if (pollTimer) clearInterval(pollTimer);
  });
}

function setStatus(running) {
  const b = document.getElementById("status-badge");
  b.textContent = running ? "● 監察中" : "● 已停止";
  b.className   = running ? "running"  : "stopped";
}

function startPolling(ms) {
  if (pollTimer) clearInterval(pollTimer);
  fetchData();
  pollTimer = setInterval(fetchData, ms);
}

function fetchData() {
  fetch("/data").then(r => r.json()).then(renderAll);
}

function renderAll(d) {
  document.getElementById("info-race").textContent   = d.race_date ? `${d.race_date} ${d.venue_name} 第${d.race_no}場` : "—";
  document.getElementById("info-count").textContent  = d.update_count || "—";
  document.getElementById("info-time").textContent   = d.last_update  || "—";
  document.getElementById("info-base").textContent   = d.base_time    || "—";
  document.getElementById("info-status").textContent = d.status       || "—";
  setStatus(d.running);

  // 主表格
  const tbody = document.getElementById("odds-tbody");
  if (!d.rows || d.rows.length === 0) {
    tbody.innerHTML = `<tr><td colspan="11" style="text-align:center;padding:30px;color:#484f58">${d.status}</td></tr>`;
  } else {
    tbody.innerHTML = d.rows.map(r => {
      const chgClass = r.chg.startsWith("+") ? "chg-up" : r.chg.startsWith("-") ? "chg-down" : "";
      const badgeHtml = r.trend === "—"
        ? `<span class="badge neutral">—</span>`
        : `<span class="badge ${r.trend_css}">${
            r.trend==="急跌"?"🔴 急跌":r.trend==="持跌"?"🟡 持跌":
            r.trend==="持升"?"🟢 持升":"🟢 回升"}</span>`;
      return `<tr class="${r.trend_css}" onclick="highlightHorse('${r.no}')">
        <td><b>${r.no}</b></td>
        <td>${r.name}</td><td>${r.draw}</td>
        <td>${r.jockey}</td><td>${r.trainer}</td>
        <td class="base-win">${r.base_win}</td>
        <td class="prev-win">${r.prev_win}</td>
        <td class="curr-win">${r.win}</td>
        <td>${r.place}</td>
        <td class="${chgClass}">${r.chg}</td>
        <td>${badgeHtml}</td>
      </tr>`;
    }).join("");
  }

  // 走勢圖
  if (d.history && d.timestamps) {
    allHistory    = d.history;
    allNames      = d.horses || {};
    allTimestamps = d.timestamps;
    buildHorseBtns(allNames);
    updateChart();
  }

  // 落飛頭三
  const downEl = document.getElementById("picks-down");
  downEl.innerHTML = d.top_down && d.top_down.length
    ? d.top_down.map((h,i) => `
        <div class="pick-item">
          <span class="medal">${medals[i]}</span>
          <div><div class="pick-name">${h.name}</div>
          <div class="pick-no">馬號${h.no} │ 基準:${h.base} │ 連跌:${h.streak}次 │ 累跌:${h.drop}%</div></div>
          <div class="pick-stats">
            <div class="pick-win down">${h.win}</div><div>現賠率</div>
          </div>
        </div>`).join("")
    : `<p style="color:#484f58;font-size:12px">暫無數據...</p>`;

  // 回升頭三
  const upEl = document.getElementById("picks-up");
  upEl.innerHTML = d.top_up && d.top_up.length
    ? d.top_up.map((h,i) => `
        <div class="pick-item">
          <span class="medal">${medals[i]}</span>
          <div><div class="pick-name">${h.name}</div>
          <div class="pick-no">馬號${h.no} │ 基準:${h.base} │ 連升:${h.streak}次 │ 累升:${h.rise}%</div></div>
          <div class="pick-stats">
            <div class="pick-win up">${h.win}</div><div>現賠率</div>
          </div>
        </div>`).join("")
    : `<p style="color:#484f58;font-size:12px">暫無數據...</p>`;
}

// 點擊表格行高亮圖表
function highlightHorse(no) {
  const btn = document.querySelector(`.horse-btn[data-no="${no}"]`);
  if (btn) btn.click();
}
</script>
</body>
</html>
