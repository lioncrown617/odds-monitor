<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>HKJC 大戶熱錢監察系統 v2</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
*{box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#111;color:#eee;margin:0;padding:14px;font-size:14px}
h2{margin:8px 0;font-size:16px}
.panel{background:#1b1b1b;border-radius:10px;padding:12px;margin-bottom:12px}
.controls{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
.controls label{display:flex;flex-direction:column;gap:3px;font-size:13px}
input,select{padding:6px 8px;border-radius:6px;border:1px solid #444;background:#222;color:#eee;width:130px}
button{padding:7px 16px;border-radius:6px;border:none;cursor:pointer;font-size:13px}
#btnStart{background:#1a6b2e;color:#fff}
#btnStop{background:#7a1f1f;color:#fff}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.card{background:#181818;border:1px solid #2a2a2a;border-radius:8px;padding:10px}
.card h3{margin:0 0 6px;font-size:14px}
.status-bar{display:flex;gap:20px;flex-wrap:wrap;font-size:13px;color:#aaa}
.status-bar span b{color:#eee}
.alert-box{max-height:180px;overflow-y:auto;font-size:12px;font-family:monospace}
.alert-item{padding:3px 0;border-bottom:1px solid #222}
.alert-item.warn{color:#ffc060}
.alert-item.suspicious{color:#d39bff}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:6px 5px;border-bottom:1px solid #252525;text-align:center;white-space:nowrap}
th{background:#141414;position:sticky;top:0;z-index:1}
tr.hot   td{background:rgba(255,60,60,.14)}
tr.warm  td{background:rgba(255,170,40,.10)}
tr.rise  td{background:rgba(60,170,255,.09)}
tr.suspicious-row{outline:2px solid #9b44ff}
tr.suspicious-row td{background:rgba(155,68,255,.12)}
.c-hot{color:#ff6060}.c-up{color:#5fd98a}.c-diluted{color:#7ab0ff}.c-neutral{color:#aaa}
.pill{display:inline-block;padding:1px 6px;border-radius:999px;font-size:11px;margin-left:3px}
.pill-red{background:#7a1f1f;color:#ffd0d0}
.pill-purple{background:#4b1a80;color:#e8c8ff}
.pill-green{background:#1a4d2a;color:#b0ffcc}
.chart-wrap{max-height:320px}
.btn-horse{padding:3px 8px;margin:2px;border-radius:4px;border:1px solid #444;background:#222;color:#ccc;cursor:pointer;font-size:12px}
.btn-horse.active{background:#3a3a80;color:#fff;border-color:#6666cc}
@media(max-width:900px){.grid3{grid-template-columns:1fr}}
</style>
</head>
<body>

<h2>🏇 HKJC 大戶熱錢監察系統 <small style="color:#888;font-size:12px">v2 · 改良SMS公式 · 洗碼偵測</small></h2>

<div class="panel">
  <div class="controls">
    <label>📅 日期 <input id="date" type="date"/></label>
    <label>🏟 場地
      <select id="venue">
        <option value="ST">ST - 沙田</option>
        <option value="HV">HV - 跑馬地</option>
      </select>
    </label>
    <label>🔢 場次 <input id="race_no" type="number" min="1" max="12" value="1"/></label>
    <label>⏱ 間隔(秒) <input id="interval" type="number" min="15" value="30"/></label>
    <button id="btnStart" onclick="startMonitor()">▶ 開始監察</button>
    <button id="btnStop"  onclick="stopMonitor()">■ 停止</button>
  </div>
</div>

<div class="panel">
  <div class="status-bar">
    <span>場次：<b id="race_info">—</b></span>
    <span>更新：<b id="update_count">0</b></span>
    <span>最後更新：<b id="last_update">—</b></span>
    <span>基準時間：<b id="base_time">—</b></span>
    <span>💰 彩池：<b id="win_pool">—</b></span>
    <span>狀態：<b id="status">等待中</b></span>
  </div>
</div>

<div class="grid3">
  <div class="card">
    <h3>🏆 SMS資金頭三位</h3>
    <div id="top_down">等待數據...</div>
  </div>
  <div class="card">
    <h3>📈 賠率回升頭三位</h3>
    <div id="top_up">等待數據...</div>
  </div>
  <div class="card" style="border-color:#6b2fa0">
    <h3>🔔 疑似洗碼受益馬 <span class="pill pill-purple">新</span></h3>
    <div id="top_suspicious" style="font-size:12px">等待數據...</div>
    <div style="color:#888;font-size:11px;margin-top:6px">賠率由監察最低點反彈&gt;50%且仍有資金流入，可能是被洗碼目標</div>
  </div>
</div>

<div class="panel">
  <h3>🚨 大戶異動警報 <span style="font-size:12px;color:#aaa">（最新50條）</span></h3>
  <div class="alert-box" id="alerts"><span style="color:#666">等待數據...</span></div>
  <div style="margin-top:6px;font-size:11px;color:#666">
    🚨單次吸金≥30% &nbsp;⚡賠率加速連跌 &nbsp;💥突發大注 &nbsp;🔔疑似洗碼受益
  </div>
</div>

<div class="panel">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
    <h3 style="margin:0">📊 即時監察表</h3>
    <span style="font-size:11px;color:#666">紫框=疑似洗碼 · 改良SMS=F^1.2×(1+D/10)×(1+E有效/10)×Wt</span>
  </div>
  <div style="overflow:auto;max-height:65vh">
    <table>
      <thead>
        <tr>
          <th>色</th><th>馬號</th><th>馬名</th><th>檔</th><th>騎師</th><th>練馬師</th>
          <th>基準賠</th><th>⭐WIN</th><th>賠率變動</th><th>賠率跌速</th><th>走勢</th>
          <th>基準投注</th><th>現時投注</th><th>累積增減</th><th>本次流入</th><th>加速度</th>
          <th>累積真實流入</th><th>🔥超額吸金</th><th>🏆SMS</th><th>由低反彈%</th><th>🚨警報</th>
        </tr>
      </thead>
      <tbody id="tbody"><tr><td colspan="21" style="color:#666;padding:20px">請設定場次後按「開始監察」</td></tr></tbody>
    </table>
  </div>
</div>

<div class="panel">
  <h3>📈 走勢圖</h3>
  <div style="display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap">
    <button class="btn-horse" onclick="setChart('odds')">獨贏賠率</button>
    <button class="btn-horse" onclick="setChart('bet')">💰 估算投注額</button>
    <button class="btn-horse" onclick="setChart('flow')">💧 每次流入</button>
    <button class="btn-horse" onclick="setChart('absorb')">🔥 超額吸金率</button>
    <button class="btn-horse" onclick="setChart('sms')">🏆 SMS評分</button>
  </div>
  <div style="margin-bottom:6px;font-size:12px;color:#888">點擊馬號高亮單匹 ↓</div>
  <div id="horse_btns" style="margin-bottom:8px"></div>
  <div class="chart-wrap"><canvas id="myChart"></canvas></div>
  <div style="margin-top:6px;font-size:11px;color:#666">💡 SMS評分持續上升是最強買入訊號；由低反彈%持續升高需警惕洗碼</div>
</div>

<script>
const $=id=>document.getElementById(id);
let chartMode='odds', focusHorse=null, myChart=null;
let lastData={rows:[],timestamps:[],history:{},bet_history:{},flow_history:{},absorb_history:{},sms_history:{},horses:{}};

document.addEventListener('DOMContentLoaded',()=>{
  const d=new Date(); $('date').value=d.toISOString().slice(0,10);
  refresh(); setInterval(refresh,5000);
});

async function startMonitor(){
  const r=await fetch('/start',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({date:$('date').value,venue:$('venue').value,race_no:$('race_no').value,interval:$('interval').value})});
  const j=await r.json();
  if(!j.ok) alert(j.msg||'啟動失敗');
  refresh();
}
async function stopMonitor(){await fetch('/stop',{method:'POST'});refresh();}

function money(v){const n=Number(v||0);if(n>=1e6)return'$'+(n/1e6).toFixed(2)+'M';if(n>=1000)return'$'+(n/1000).toFixed(1)+'K';return'$'+n.toFixed(0);}

function renderTop(el,items,tpl){
  if(!items||!items.length){el.innerHTML='<span style="color:#666">等待數據...</span>';return;}
  el.innerHTML=items.map(tpl).join('');
}

async function refresh(){
  try{
    const res=await fetch('/data'); const d=await res.json();
    $('race_info').textContent=d.venue_name&&d.race_no?`${d.venue_name} 第${d.race_no}場`:'—';
    $('update_count').textContent=d.update_count??0;
    $('last_update').textContent=d.last_update||'—';
    $('base_time').textContent=d.base_time||'—';
    $('win_pool').textContent=d.win_pool||'—';
    $('status').textContent=d.status||'等待中';

    renderTop($('top_down'),d.top_down,x=>`<div style="margin-bottom:6px">
      <b>馬${x.no} ${x.name}</b> <span style="color:#ffd060">${x.win}</span>
      <br><span style="color:#888;font-size:12px">連跌${x.streak}次 跌幅${x.drop}% SMS:${x.sms}</span></div>`);

    renderTop($('top_up'),d.top_up,x=>`<div style="margin-bottom:6px">
      <b>馬${x.no} ${x.name}</b> <span style="color:#5fd98a">${x.win}</span>
      <br><span style="color:#888;font-size:12px">連升${x.streak}次 升幅${x.rise}%</span></div>`);

    renderTop($('top_suspicious'),d.top_suspicious,x=>`<div style="margin-bottom:6px;color:#d39bff">
      <b>馬${x.no} ${x.name}</b> 現賠${x.win}
      <br><span style="font-size:11px">監察最低:${x.min_odds} 反彈:${x.rise_pct}% 累流入:${money(x.cum_inflow)}</span></div>`);

    const alertBox=$('alerts');
    if(d.alerts&&d.alerts.length){
      alertBox.innerHTML=d.alerts.map(a=>{
        const isSusp=a.msg.includes('洗碼');
        const cls=isSusp?'alert-item suspicious':'alert-item warn';
        return `<div class="${cls}">${a.time} 馬${a.no} ${a.name}$${a.win} ${a.msg} 流入${money(a.flow_amt)} 彩池+${money(a.pool_inc)}</div>`;
      }).join('');
    }else{alertBox.innerHTML='<span style="color:#666">目前未有警報</span>';}

    $('tbody').innerHTML=(d.rows||[]).map(r=>{
      const base_css=r.trend_css||'neutral';
      const tr_cls=(r.is_suspicious?'suspicious-row ':'')+
        (base_css==='hot'?'hot':base_css==='warm'?'warm':base_css==='rise'?'rise':'');
      const color_dot=r.is_suspicious?'🟣':base_css==='hot'?'🔴':base_css==='warm'?'🟡':base_css==='rise'?'🟢':'⚪';
      const sms_pill=r.is_suspicious?`<span class="pill pill-purple">洗碼?</span>`:
        (Number(r.sms_raw||0)>5?'<span class="pill pill-red">強</span>':'');
      return `<tr class="${tr_cls.trim()}">
        <td>${color_dot}</td>
        <td>${r.no}</td><td>${r.name}</td><td>${r.draw}</td><td>${r.jockey}</td><td>${r.trainer}</td>
        <td>${r.base_win}</td>
        <td><b>${r.win}</b></td>
        <td class="c-${r.chg&&r.chg.startsWith('-')?'diluted':'up'}">${r.chg}</td>
        <td class="c-${r.odrop_css}">${r.odrop}</td>
        <td class="c-${r.trend_css}">${r.trend}</td>
        <td>${r.base_bet}</td>
        <td>${r.est_bet} <span style="color:#888">${r.est_pct}</span></td>
        <td class="c-${r.cum_diff_css}">${r.cum_diff} ${r.cum_diff_pct}</td>
        <td class="c-${r.flow_css}">${r.flow}</td>
        <td class="c-${r.accel_css}">${r.accel}</td>
        <td class="c-up">${r.cum_inflow}</td>
        <td class="c-${r.absorb_css}">${r.absorb}</td>
        <td class="c-${r.sms_css}">${r.sms}${sms_pill}</td>
        <td class="${r.is_suspicious?'c-hot':Number(r.rise_from_min||0)>20?'c-diluted':'c-neutral'}">${r.rise_from_min}%</td>
        <td style="color:#ffc060;font-size:12px">${r.alert}</td>
      </tr>`;
    }).join('');

    lastData=d;
    updateHorseBtns();
    drawChart();
  }catch(e){$('status').textContent='讀取失敗: '+e.message;}
}

function updateHorseBtns(){
  const horses=lastData.horses||{};
  const keys=Object.keys(horses);
  if(!keys.length)return;
  $('horse_btns').innerHTML=keys.map(no=>`<button class="btn-horse${focusHorse===no?' active':''}" onclick="toggleHorse('${no}')">馬${no}</button>`).join('');
}

function toggleHorse(no){focusHorse=(focusHorse===no)?null:no; updateHorseBtns(); drawChart();}
function setChart(m){chartMode=m; drawChart();}

const COLORS=['#ff6060','#ffd060','#5fd98a','#60b0ff','#d39bff','#ff9f40','#4bc0c0','#ff7eb6','#a0a0ff','#c0e060','#ff8040','#80ffcc','#ffcc00'];

function drawChart(){
  const ts=lastData.timestamps||[];
  if(!ts.length)return;
  const histMap={odds:'history',bet:'bet_history',flow:'flow_history',absorb:'absorb_history',sms:'sms_history'}[chartMode]||'history';
  const dataMap=lastData[histMap]||{};
  const horses=lastData.horses||{};
  const keys=Object.keys(horses);
  const datasets=keys.map((no,i)=>{
    const vals=dataMap[no]||[];
    const color=COLORS[i%COLORS.length];
    const hidden=focusHorse&&focusHorse!==no;
    return{label:`馬${no} ${horses[no]}`,data:vals,borderColor:color,backgroundColor:color+'30',
      tension:0.3,pointRadius:2,borderWidth:focusHorse===no?3:1.5,hidden:!!hidden};
  });
  const yLabel={odds:'賠率',bet:'估算投注($)',flow:'流入($)',absorb:'超額吸金%',sms:'SMS評分'}[chartMode]||'';
  if(myChart){myChart.destroy();}
  myChart=new Chart($('myChart'),{
    type:'line',
    data:{labels:ts,datasets},
    options:{
      responsive:true,maintainAspectRatio:false,
      animation:{duration:300},
      plugins:{legend:{labels:{color:'#ccc',font:{size:11}},position:'bottom'}},
      scales:{
        x:{ticks:{color:'#888',maxTicksLimit:12},grid:{color:'#222'}},
        y:{ticks:{color:'#888'},grid:{color:'#222'},title:{display:true,text:yLabel,color:'#888'}}
      }
    }
  });
}
</script>
</body>
</html>
